<?xml version="1.0" encoding="UTF-8" standalone="yes" ?>
<emIDE_project_file>
	<FileVersion major="1" minor="7" />
	<Project>
		<Option title="MultiMediaParser" />
		<Option execution_dir="." />
		<Option pch_mode="2" />
		<Option compiler="armelfgcc" />
		<Option DownloadLog="-1" />
		<Option ProjectVersion="V1.0.2.1" />
		<Build>
			<Target title="Debug">
				<Option output="../../liba/MultiMediaParser" prefix_auto="1" extension_auto="1" />
				<Option working_dir="" />
				<Option object_output="obj/Debug/" />
				<Option type="0" />
				<Option compiler="armelfgcc" />
				<Option createDefFile="1" />
				<Compiler>
					<Add option="-O2" />
					<Add option="-g" />
					<Add option="-DGP_FREERTOS" />
					<Add option="-DDEBUG=1" />
					<Add option="-DSEEK64_EN" />
					<Add option="-fdata-sections" />
					<Add option="-ffunction-sections" />
					<Add option="-mcpu=cortex-a7" />
					<Add option="-mfpu=neon-vfpv4" />
					<Add option="-mfloat-abi=softfp" />
					<Add directory="../gplib_MultiMediaParser/Src" />
					<Add directory="../../../application/inc/" />
					<Add directory="../../../application/msg_manager/inc/" />
					<Add directory="../../../driver_l1/inc/" />
					<Add directory="../../../driver_l2/inc/" />
					<Add directory="../../../driver_l2/scaler/inc/" />
					<Add directory="../../../CMSIS/Include" />
					<Add directory="../../../os/freertos_v202012/Source/include" />
					<Add directory="../../../os/freertos_v202012/Source/portable/GCC/ARM_CA9" />
					<Add directory="../../../os" />
					<Add directory="../../../gplib/inc" />
					<Add directory="../../../gplib/mm/inc" />
					<Add directory="../../../gplib/print_string/inc" />
					<Add directory="../../../gpstdlib/inc" />
					<Add directory="../../../project/Include" />
				</Compiler>
				<Linker>
					<Add option="-Wl,-Map" />
					<Add option="-Wl,${TARGET_OUTPUT_FILE}.map" />
					<Add option="-Wl,--gc-sections" />
					<Add option="-n" />
					<Add option="-Wl,-cref" />
					<Add option="-mcpu=cortex-a7" />
					<Add option="-mfpu=neon-vfpv4" />
					<Add option="-specs=nosys.specs" />
				</Linker>
				<ExtraCommands>
					<Add after="arm-none-eabi-size.exe ..\..\liba\libMultiMediaParser.a" />
				</ExtraCommands>
				<PostOutput>
					<ConvertedOutput PostOutputCreate="0" />
					<ConvertedOutput PostOutputType="HEX" />
					<ConvertedOutput PostOutputFile="${TARGET_OUTPUT_DIR}${TARGET_OUTPUT_BASENAME}" />
				</PostOutput>
			</Target>
			<Target title="Release">
				<Option output="bin/Release/MultiMediaParser" prefix_auto="1" extension_auto="1" />
				<Option working_dir="" />
				<Option object_output="obj/Release/" />
				<Option type="0" />
				<Option compiler="armelfgcc" />
				<Option createDefFile="1" />
				<Compiler>
					<Add option="-mcpu=cortex-m4" />
					<Add option="-specs=nano.specs" />
					<Add option="-mthumb" />
					<Add option="-g" />
					<Add option="-O2" />
					<Add directory="Inc" />
				</Compiler>
				<Linker>
					<Add option="-Wl,-Map" />
					<Add option="-Wl,${TARGET_OUTPUT_FILE}.map" />
					<Add option="-Wl,--gc-sections" />
					<Add option="-n" />
					<Add option="-Wl,-cref" />
					<Add option="-mcpu=cortex-m4" />
					<Add option="-mthumb" />
					<Add option=" -TSetup/GPM4730A_DDR.ld" />
					<Add option="-s" />
				</Linker>
				<ExtraCommands>
					<Add after="arm-none-eabi-size.exe ..\..\liba\libMultiMediaParser.a" />
				</ExtraCommands>
				<PostOutput>
					<ConvertedOutput PostOutputCreate="0" />
					<ConvertedOutput PostOutputType="HEX" />
					<ConvertedOutput PostOutputFile="${TARGET_OUTPUT_DIR}${TARGET_OUTPUT_BASENAME}" />
				</PostOutput>
			</Target>
		</Build>
		<PostOutput>
			<ConvertedOutput PostOutputCreate="0" />
			<ConvertedOutput PostOutputType="HEX" />
			<ConvertedOutput PostOutputFile="${TARGET_OUTPUT_DIR}${TARGET_OUTPUT_BASENAME}" />
		</PostOutput>
		<Unit filename="Src/MediaParser.h" />
		<Unit filename="Src/MultiMediaParser.h" />
		<Unit filename="Src/MultiMediaParser_Task.c">
			<Option compilerVar="CC" />
		</Unit>
		<Unit filename="Src/MultiMediaParser_def.h" />
		<Extensions>
			<projectwizard TargetDevice="GPA7740A" isCreated="true" />
			<code_completion />
			<debugger>
				<remote_debugging>
					<options conn_type="0" ip_address="localhost" ip_port="2331" clock_rate="1000" target_device="GPA7740A" remote_server="Build in GDB Server" Break_at_Main="0" Break_at_Main_Symbol="main" En_BeforeDownload_Script="0" En_AfterReset_Script="0" En_ReplaceBody_Script="0" En_StackOverflowDetection="1" En_Semihosting="0" />
				</remote_debugging>
				<remote_debugging target="Debug">
					<options conn_type="0" serial_baud="115200" ip_address="localhost" ip_port="2331" clock_rate="1000" target_device="GPA7740A" remote_server="Build in GDB Server" Break_at_Main="1" Break_at_Main_Symbol="main" additional_cmds="monitor reset halt&#x0A;load" En_BeforeDownload_Script="0" En_AfterReset_Script="0" En_ReplaceBody_Script="0" En_StackOverflowDetection="0" En_Semihosting="0" />
				</remote_debugging>
				<remote_debugging target="Release">
					<options conn_type="0" serial_baud="115200" ip_address="localhost" ip_port="2331" clock_rate="1000" target_device="GPA7740A" remote_server="Build in GDB Server" Break_at_Main="1" Break_at_Main_Symbol="main" additional_cmds="monitor reset halt&#x0A;load" En_BeforeDownload_Script="0" En_AfterReset_Script="0" En_ReplaceBody_Script="0" En_StackOverflowDetection="1" En_Semihosting="0" />
				</remote_debugging>
			</debugger>
		</Extensions>
	</Project>
</emIDE_project_file>
